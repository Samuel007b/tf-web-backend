meta {
  name: Buscar usuário (GET userAdmin/:id)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/user/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("deve retornar o usuário criado", function() {
    expect(res.getBody().id).to.eql(Number(bru.getEnvVar('userId')));
  });
}
