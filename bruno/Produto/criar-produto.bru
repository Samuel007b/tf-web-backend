meta {
  name: Criar produto (POST produtos)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/produtos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Produto Teste Bruno",
    "foto": "https://exemplo.com/foto.jpg",
    "categoria": "UNITARIO",
    "preco": 9.9,
    "descricao": "Produto criado pela coleção de testes do Bruno"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("produtoId", res.getBody().id);
  }
}

assert {
  res.status: eq 201
}

tests {
  test("deve criar o produto", function() {
    expect(res.getBody()).to.have.property('id');
    expect(res.getBody().nome).to.eql('Produto Teste Bruno');
  });
}
