meta {
  name: Buscar avaliação (GET avaliacoes/:id)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/avaliacoes/{{avaliacaoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("deve retornar a avaliação criada", function() {
    expect(res.getBody().id).to.eql(Number(bru.getEnvVar('avaliacaoId')));
  });
}
